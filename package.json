{
  "name": "buggy-store",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start": "npm run build && concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:start:api\" \"npm:start:web\"",
    "start:api": "tsx server/index.ts",
    "start:web": "vite preview",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "db:reset": "tsx server/scripts/reset-db.ts",
    "db:reset:large": "tsx server/scripts/reset-db.ts --large",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test --project=baseline",
    "test:e2e:defects": "playwright test --project=defects",
    "test:e2e:report": "playwright show-report",
    "typecheck": "tsc -b",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "arch": "arcguard check",
    "arch:analyze": "arcguard analyze",
    "arch:rules": "arcguard list-rules",
    "prepare": "husky"
  },
  "dependencies": {
    "@7edge/arcguard": "file:./packages/arcguard",
    "better-sqlite3": "12.11.1",
    "express": "5.2.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "7.6.13",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "9.2.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-dom": "5.28.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "eslint-plugin-react-x": "5.28.0",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,css,md,html,yml,yaml}": [
      "prettier --write"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
